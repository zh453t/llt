<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 下载数据包与版本接口（两者都是明文 HTTP，见 application 的 usesCleartextTraffic） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- 自己实现的 NativeActivity 子类：为了拿到 onActivityResult（系统文件选择器）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode">
            <!-- NativeActivity 按这个名字加载 .so（对应 Rust 的 cdylib llt_gui_android）。 -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="llt_gui_android" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
